{
  "permissions": {
    "allow": [
      "Bash(.venv/bin/pytest:*)",
      "Bash(.venv/bin/ruff:*)",
      "Bash(.venv/bin/analystos:*)",
      "Bash(.venv/bin/python scripts/*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run build:*)",
      "Bash(npm test:*)"
    ],
    "deny": [
      "Bash(git add -A:*)",
      "Bash(git commit -a:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
