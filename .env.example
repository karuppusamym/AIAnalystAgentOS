# Copy to .env and fill in. Never commit .env. Secrets are read from the environment only.
OPENROUTER_API_KEY=            # OpenRouter key: chat models + TypeSafe Jev decisions (Decisions API)
ANALYSTOS_JWT_SECRET=          # >= 32 random bytes in any shared environment
# ANALYSTOS_ORCHESTRATOR=temporal   # temporal (default) | local (single-process, tests)
# ANALYSTOS_DATABASE_URL=postgresql+psycopg://analystos:analystos@localhost:5432/analystos
# ANALYSTOS_ANALYTICS_READER_URL=postgresql+psycopg://analystos_reader:reader@localhost:5432/analytics
# ANALYSTOS_ANALYTICS_LOADER_URL=postgresql+psycopg://analystos_loader:loader@localhost:5432/analytics
# ANALYSTOS_SUPERSET_URL=http://localhost:8088
# ANALYSTOS_CONTEXT2AI_URL=         # existing Context2AI service; local context store when unset
# Source credentials are referenced by sources as secret_ref "env:NAME", e.g.:
# SERVICENOW_PASSWORD=
# Outbound HTTP (HTTP tools, MCP servers): refused for non-public addresses unless listed here.
# ANALYSTOS_HTTP_TOOL_ALLOWLIST=tickets.example.com   # hostnames HTTP tool capabilities may call
# ANALYSTOS_OUTBOUND_PRIVATE_HOSTS=127.0.0.1,mcp.internal,10.20.0.0/16   # hosts/CIDRs allowed despite being private
