{
  "$defs": {
    "Check": {
      "additionalProperties": true,
      "properties": {
        "check": {
          "title": "Check",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "not_applicable"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "check",
        "outcome"
      ],
      "title": "Check",
      "type": "object"
    },
    "Confirmation": {
      "additionalProperties": false,
      "description": "Result of evaluating the confirmation rules for one finding.",
      "properties": {
        "rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        },
        "passed": {
          "default": false,
          "title": "Passed",
          "type": "boolean"
        },
        "evaluated": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Evaluated",
          "type": "array"
        }
      },
      "title": "Confirmation",
      "type": "object"
    },
    "Freshness": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "default": "current",
          "enum": [
            "current",
            "stale",
            "unknown"
          ],
          "title": "State",
          "type": "string"
        },
        "since": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Since"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "assets": {
          "items": {
            "type": "string"
          },
          "title": "Assets",
          "type": "array"
        }
      },
      "title": "Freshness",
      "type": "object"
    },
    "HoldoutCheck": {
      "additionalProperties": false,
      "description": "The held-out confirmation of one claim (P8-15, `evidence.holdout`): the claim was locked, then the same\ntest ran once on rows the discovery never read. `evaluated` False says why it did not run.",
      "properties": {
        "evaluated": {
          "title": "Evaluated",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "partition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Partition"
        },
        "partition_spec": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Partition Spec"
        },
        "claim": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim"
        },
        "claim_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim Hash"
        },
        "claim_locked_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim Locked At"
        },
        "partition_accessed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Partition Accessed At"
        },
        "supported": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supported"
        },
        "top": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top"
        },
        "direction": {
          "anyOf": [
            {
              "enum": [
                "higher",
                "lower",
                "increase",
                "decrease",
                "equal"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction"
        },
        "test": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Test"
        },
        "p_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P Value"
        },
        "p_one_sided": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P One Sided"
        },
        "alpha": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alpha"
        },
        "effect_size": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effect Size"
        },
        "effect_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effect Label"
        },
        "n": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N"
        },
        "contrast": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contrast"
        },
        "experiment_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Experiment Id"
        },
        "confirmed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirmed"
        }
      },
      "required": [
        "evaluated"
      ],
      "title": "HoldoutCheck",
      "type": "object"
    },
    "ReviewScore": {
      "additionalProperties": false,
      "description": "The REV confidence number. Hand-built, not calibrated: never a probability of truth.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "calibrated": {
          "const": false,
          "default": false,
          "title": "Calibrated",
          "type": "boolean"
        },
        "note": {
          "default": "heuristic review score from deterministic checks; not a calibrated probability",
          "title": "Note",
          "type": "string"
        }
      },
      "title": "ReviewScore",
      "type": "object"
    },
    "Strength": {
      "additionalProperties": false,
      "description": "How far a supported finding clears its method's bars (P8-15, `evidence.strength`): `weak` when the\neffect is under 1.5x the method's minimum effect or the adjusted p-value is within 10x of alpha. Computed\nfrom the statistic alone; no model is involved.",
      "properties": {
        "label": {
          "enum": [
            "weak",
            "moderate",
            "strong"
          ],
          "title": "Label",
          "type": "string"
        },
        "effect": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effect"
        },
        "effect_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effect Label"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "margin": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Margin"
        },
        "q": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Q"
        },
        "alpha": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alpha"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "rule": {
          "default": "strength.v1",
          "title": "Rule",
          "type": "string"
        }
      },
      "required": [
        "label"
      ],
      "title": "Strength",
      "type": "object"
    },
    "Validation": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "exploratory",
            "replicated",
            "confirmed",
            "inconclusive",
            "invalid",
            "insufficient_evidence",
            "legacy"
          ],
          "title": "State",
          "type": "string"
        },
        "label": {
          "enum": [
            "discovery",
            "confirmation",
            "legacy"
          ],
          "title": "Label",
          "type": "string"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/Check"
          },
          "title": "Checks",
          "type": "array"
        },
        "confirmation": {
          "$ref": "#/$defs/Confirmation"
        },
        "missing_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Missing Evidence",
          "type": "array"
        },
        "reproducible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reproducible"
        },
        "predictive_evaluated": {
          "default": false,
          "title": "Predictive Evaluated",
          "type": "boolean"
        },
        "strength": {
          "anyOf": [
            {
              "$ref": "#/$defs/Strength"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "holdout": {
          "anyOf": [
            {
              "$ref": "#/$defs/HoldoutCheck"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "state",
        "label"
      ],
      "title": "Validation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "default": "evidence.v1",
      "title": "Version",
      "type": "string"
    },
    "verifier_version": {
      "default": "rev.v2",
      "title": "Verifier Version",
      "type": "string"
    },
    "data": {
      "additionalProperties": true,
      "title": "Data",
      "type": "object"
    },
    "claim": {
      "additionalProperties": true,
      "title": "Claim",
      "type": "object"
    },
    "method": {
      "additionalProperties": true,
      "title": "Method",
      "type": "object"
    },
    "validation": {
      "$ref": "#/$defs/Validation"
    },
    "limits": {
      "additionalProperties": true,
      "title": "Limits",
      "type": "object"
    },
    "freshness": {
      "$ref": "#/$defs/Freshness"
    },
    "review_score": {
      "$ref": "#/$defs/ReviewScore"
    },
    "legacy": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Legacy"
    }
  },
  "required": [
    "validation"
  ],
  "title": "EvidenceBundle",
  "type": "object"
}
