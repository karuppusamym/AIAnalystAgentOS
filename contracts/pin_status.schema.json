          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "pinned": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pinned"
        },
        "current": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current"
        },
        "state": {
          "default": "current",
          "enum": [
            "current",
            "newer",
            "deprecated",
            "retired",
            "rejected"
          ],
          "title": "State",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
