        "diff": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Diff",
          "type": "array"
        }
      },
      "required": [
        "type",
        "id",
        "pinned"
      ],
      "title": "PinItem",
      "type": "object"
    }
  },
  "description": "Upgrade-available / deprecated / blocked, computed in code from the pins and the registries.",
