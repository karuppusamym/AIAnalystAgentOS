{
  "$defs": {
    "AttributeRule": {
      "description": "ABAC (SEC-003): data a caller may only see when their user attributes match. Attributes come\nfrom the IdP (OIDC claims mapped in config/oidc.yaml) or an administrator. Rules only remove data\nfrom a scope, never add: `assets` (\"schema.table\", \"*.table\") are dropped whole, `columns`\n(\"schema.table.column\", \"*.column\") and columns carrying one of `column_tags` become denied.\n`require` maps an attribute to its accepted values; every listed attribute must match (a user\nattribute that is a list matches when any element does).",
      "properties": {
        "id": {
          "default": "",
          "title": "Id",
          "type": "string"
        },
        "assets": {
          "items": {
            "type": "string"
          },
          "title": "Assets",
          "type": "array"
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "title": "Columns",
          "type": "array"
        },
        "column_tags": {
          "items": {
            "type": "string"
          },
          "title": "Column Tags",
          "type": "array"
        },
        "require": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Require",
          "type": "object"
        }
      },
      "title": "AttributeRule",
      "type": "object"
    },
    "ContextProviderConfig": {
      "properties": {
        "kind": {
          "enum": [
            "local",
            "okf_import",
            "mcp"
          ],
          "title": "Kind",
          "type": "string"
        },
        "slug": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slug"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "server": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Server"
        },
        "product_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Key"
        },
        "version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool"
        },
        "max_chars": {
          "anyOf": [
            {
              "maximum": 48000,
              "minimum": 1000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Chars"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ContextProviderConfig",
      "type": "object"
    },
    "RowFilter": {
      "description": "Row-level security (P7-02, ADR-0019): rows of the matching assets a caller may see. `predicate` is a\nboolean SQL expression over the asset's own columns and may reference the caller's attributes as\n`{{user.<attribute>}}` (also `{{user.id}}`, `{{user.email}}`, `{{user.role}}`). Values become literals,\nnever SQL text; a list value expands inside `IN (...)`. A missing attribute fails closed: the asset\nis withheld from that caller. Applied by the semantic compiler and again by the gateway validator, so\nno query path reads the asset unfiltered. `exempt_roles` see every row (for example owner).",
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "assets": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Assets",
          "type": "array"
        },
        "predicate": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Predicate",
          "type": "string"
        },
        "exempt_roles": {
          "items": {
            "type": "string"
          },
          "title": "Exempt Roles",
          "type": "array"
        }
      },
      "required": [
        "id",
        "assets",
        "predicate"
      ],
      "title": "RowFilter",
      "type": "object"
    }
  },
  "description": "Versioned per-workspace policy. Values here may only tighten the platform ceilings.",
  "properties": {
    "max_rows": {
      "default": 50000,
      "title": "Max Rows",
      "type": "integer"
    },
    "query_timeout_seconds": {
      "default": 30,
      "title": "Query Timeout Seconds",
      "type": "integer"
    },
    "max_queries_per_run": {
      "default": 200,
      "title": "Max Queries Per Run",
      "type": "integer"
    },
    "ask_queries_per_user_per_hour": {
      "default": 60,
      "title": "Ask Queries Per User Per Hour",
      "type": "integer"
    },
    "ask_queries_per_workspace_per_hour": {
      "default": 600,
      "title": "Ask Queries Per Workspace Per Hour",
      "type": "integer"
    },
    "run_token_budget": {
      "default": 400000,
      "title": "Run Token Budget",
      "type": "integer"
    },
    "run_cost_budget_usd": {
      "default": 2.0,
      "title": "Run Cost Budget Usd",
      "type": "number"
    },
    "workspace_monthly_cost_budget_usd": {
      "default": 50.0,
      "title": "Workspace Monthly Cost Budget Usd",
      "type": "number"
    },
    "expensive_model_approval_usd": {
      "default": 1.0,
      "title": "Expensive Model Approval Usd",
      "type": "number"
    },
    "allowed_models": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Models",
      "type": "array"
    },
    "allowed_providers": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Providers",
      "type": "array"
    },
    "data_residency": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Data Residency"
    },
    "send_data_samples_to_models": {
      "default": false,
      "title": "Send Data Samples To Models",
      "type": "boolean"
    },
    "independent_model_verification": {
      "default": false,
      "title": "Independent Model Verification",
      "type": "boolean"
    },
    "restricted_columns": {
      "items": {
        "type": "string"
      },
      "title": "Restricted Columns",
      "type": "array"
    },
    "pii_columns": {
      "items": {
        "type": "string"
      },
      "title": "Pii Columns",
      "type": "array"
    },
    "pii_access": {
      "default": "restricted",
      "enum": [
        "none",
        "restricted",
        "allowed"
      ],
      "title": "Pii Access",
      "type": "string"
    },
    "tool_denylist": {
      "items": {
        "type": "string"
      },
      "title": "Tool Denylist",
      "type": "array"
    },
    "attribute_rules": {
      "items": {
        "$ref": "#/$defs/AttributeRule"
      },
      "title": "Attribute Rules",
      "type": "array"
    },
    "row_filters": {
      "items": {
        "$ref": "#/$defs/RowFilter"
      },
      "title": "Row Filters",
      "type": "array"
    },
    "publish_destinations": {
      "items": {
        "type": "string"
      },
      "title": "Publish Destinations",
      "type": "array"
    },
    "publish_requires_approval": {
      "default": true,
      "title": "Publish Requires Approval",
      "type": "boolean"
    },
    "separation_of_duties": {
      "default": false,
      "title": "Separation Of Duties",
      "type": "boolean"
    },
    "approval_ttl_hours": {
      "default": 72,
      "title": "Approval Ttl Hours",
      "type": "integer"
    },
    "max_iterations": {
      "default": 3,
      "title": "Max Iterations",
      "type": "integer"
    },
    "alpha": {
      "default": 0.05,
      "title": "Alpha",
      "type": "number"
    },
    "domain_packs": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Domain Packs"
    },
    "context_providers": {
      "items": {
        "$ref": "#/$defs/ContextProviderConfig"
      },
      "title": "Context Providers",
      "type": "array"
    },
    "require_approved_metrics": {
      "default": false,
      "title": "Require Approved Metrics",
      "type": "boolean"
    }
  },
  "title": "WorkspacePolicyDoc",
  "type": "object"
}
