          "default": "",
          "title": "Description",
          "type": "string"
        },
        "charts": {
          "items": {
            "type": "string"
          },
          "title": "Charts",
          "type": "array"
        },
        "layout": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Layout",
          "type": "array"
        },
        "native_filters": {
          "items": {
            "type": "string"
          },
          "title": "Native Filters",
          "type": "array"
        },
        "summary_markdown": {
          "default": "",
