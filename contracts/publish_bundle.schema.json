            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Grain"
        },
        "filters": {
          "items": {
            "type": "string"
          },
          "title": "Filters",
          "type": "array"
        },
        "limit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "insight_codes": {
          "items": {
            "type": "string"
          },
          "title": "Insight Codes",
          "type": "array"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        },
        "preview": {
          "additionalProperties": true,
          "title": "Preview",
          "type": "object"
        },
        "governance": {
          "default": "ad_hoc",
          "enum": [
            "governed",
            "ad_hoc"
          ],
          "title": "Governance",
          "type": "string"
