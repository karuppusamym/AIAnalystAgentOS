{
  "$defs": {
    "ChartSpec": {
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "chart_type": {
          "enum": [
            "kpi",
            "line",
            "bar",
            "stacked_bar",
            "histogram",
            "scatter",
            "heatmap",
            "table",
            "pie",
            "treemap"
          ],
          "title": "Chart Type",
          "type": "string"
        },
        "intent": {
          "title": "Intent",
          "type": "string"
        },
        "dataset": {
          "title": "Dataset",
          "type": "string"
        },
        "metric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric"
        },
        "metrics": {
          "items": {
            "type": "string"
          },
          "title": "Metrics",
          "type": "array"
        },
        "dimension": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dimension"
        },
        "series": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Series"
        },
        "time_grain": {
          "anyOf": [
            {
              "enum": [
                "day",
                "week",
                "month"
