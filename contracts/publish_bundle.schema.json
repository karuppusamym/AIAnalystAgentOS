      "required": [
        "name",
        "display_name",
        "definition",
        "sql_expression"
      ],
      "title": "MetricDef",
      "type": "object"
    }
  },
  "description": "Exactly what gets published. Its hash is what an approval binds to.",
  "properties": {
    "workspace_id": {
      "title": "Workspace Id",
      "type": "string"
    },
    "destination": {
      "default": "superset",
      "enum": [
        "superset",
        "powerbi",
        "preview"
      ],
      "title": "Destination",
      "type": "string"
    },
    "datasets": {
      "items": {
        "$ref": "#/$defs/DatasetDef"
      },
      "title": "Datasets",
      "type": "array"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/MetricDef"
      },
      "title": "Metrics",
      "type": "array"
    },
    "charts": {
      "items": {
        "$ref": "#/$defs/ChartSpec"
      },
      "title": "Charts",
      "type": "array"
    },
    "dashboards": {
      "items": {
        "$ref": "#/$defs/DashboardSpec"
      },
      "title": "Dashboards",
      "type": "array"
    }
  },
  "required": [
    "workspace_id",
    "datasets",
    "metrics",
    "charts",
    "dashboards"
  ],
  "title": "PublishBundle",
  "type": "object"
}
