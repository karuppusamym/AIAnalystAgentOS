      },
      "required": [
        "key",
        "title",
        "audience",
        "charts"
      ],
      "title": "DashboardSpec",
      "type": "object"
    },
    "DatasetDef": {
      "description": "A reusable analytical dataset: a governed SELECT (virtual dataset; no source writes in MVP).",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "sql": {
          "title": "Sql",
          "type": "string"
        },
        "columns": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Columns",
          "type": "array"
        },
        "time_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
