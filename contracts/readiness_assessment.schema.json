{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "What an assertion rests on: an asset, a column profile, a relationship, a context entry, a check.",
      "properties": {
        "kind": {
          "enum": [
            "asset",
            "column",
            "profile",
            "relationship",
            "context",
            "metric",
            "query",
            "check",
            "user_note"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "ReadinessCheck": {
      "properties": {
        "check": {
          "title": "Check",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "needs_input",
            "warn",
            "not_applicable",
            "unsupported"
          ],
          "title": "Status",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "remediation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remediation"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "check",
        "status",
        "reason"
      ],
      "title": "ReadinessCheck",
      "type": "object"
    }
  },
  "properties": {
    "id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Id"
    },
    "workspace_id": {
      "title": "Workspace Id",
      "type": "string"
    },
    "job_kind": {
      "title": "Job Kind",
      "type": "string"
    },
    "status": {
      "enum": [
        "ready",
        "needs_input",
        "blocked",
        "unsupported"
      ],
      "title": "Status",
      "type": "string"
    },
    "brief_version": {
      "title": "Brief Version",
      "type": "integer"
    },
    "work_order_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Work Order Id"
    },
    "work_order_revision": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Work Order Revision"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/ReadinessCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "inputs": {
      "additionalProperties": true,
      "title": "Inputs",
      "type": "object"
    },
    "inputs_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Inputs Hash"
    },
    "alternatives": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Alternatives",
      "type": "array"
    },
    "created_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    }
  },
  "required": [
    "workspace_id",
    "job_kind",
    "status",
    "brief_version",
    "checks"
  ],
  "title": "ReadinessAssessmentDoc",
  "type": "object"
}
