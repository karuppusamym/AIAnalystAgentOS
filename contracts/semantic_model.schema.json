            "type": "string"
          },
          "title": "From Columns",
          "type": "array"
        },
        "to_columns": {
          "items": {
            "type": "string"
          },
          "title": "To Columns",
          "type": "array"
        },
        "ai_context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ai Context"
        },
        "custom_extensions": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Custom Extensions",
          "type": "array"
        }
      },
      "required": [
        "name",
        "from",
        "to",
        "from_columns",
        "to_columns"
      ],
      "title": "SemanticRelationship",
      "type": "object"
    }
  },
  "properties": {
    "name": {
      "title": "Name",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
