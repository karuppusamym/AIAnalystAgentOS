              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Wall Seconds"
        },
        "max_queries": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Queries"
        },
        "max_trials": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 1,
