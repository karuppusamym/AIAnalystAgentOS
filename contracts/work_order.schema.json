{
  "$defs": {
    "AnalysisSpec": {
      "description": "One executable hypothesis test. `method` must be a registered analysis method: the vocabulary,\nits JSON Schema enum and the per-method requirements come from the method registry\n(`analystos.methods`, spec v3 \u00a73.5), never from a list kept here.",
      "properties": {
        "method": {
          "description": "A registered analysis method:\nrate_by_segment: Boolean outcome rate across segment groups -> chi-square (+ grouped logistic and permutation check)\nnumeric_by_segment: Numeric outcome across segment groups -> Mann-Whitney / Kruskal-Wallis (+ bootstrap median difference)\ntrend: Volume or numeric outcome over time -> linear trend + change point (+ Mann-Kendall / Theil-Sen)\npareto: Share of volume by segment -> concentration (top-k share, Gini, GOF) (+ multinomial bootstrap of the top share)\ncorrelation: Numeric vs numeric -> Spearman (+ Pearson and a bootstrap CI of the primary coefficient)\ndriver_model: Boolean outcome vs several drivers -> logistic regression (+ random-forest permutation importance)\ncohort_retention: Retention of entity cohorts over time buckets -> chi-square across cohorts (+ grouped logistic and permutation check)\ncontribution_decomposition: Mix / volume / rate decomposition of a KPI change between two periods -> z test of the within-segment effect (+ stratified CMH / Stouffer check)",
          "enum": [
            "rate_by_segment",
            "numeric_by_segment",
            "trend",
            "pareto",
            "correlation",
            "driver_model",
            "cohort_retention",
            "contribution_decomposition"
          ],
          "title": "Method",
          "type": "string"
        },
        "asset": {
          "title": "Asset",
          "type": "string"
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/Derivation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "segment": {
          "anyOf": [
            {
              "$ref": "#/$defs/Derivation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "drivers": {
          "items": {
            "$ref": "#/$defs/Derivation"
          },
          "title": "Drivers",
          "type": "array"
        },
        "time": {
          "anyOf": [
            {
              "$ref": "#/$defs/Derivation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "filters": {
          "items": {
            "$ref": "#/$defs/Filter"
          },
          "title": "Filters",
          "type": "array"
        },
        "min_group_size": {
          "default": 30,
          "title": "Min Group Size",
          "type": "integer"
        },
        "top_k": {
          "default": 12,
          "title": "Top K",
          "type": "integer"
        }
      },
      "required": [
        "method",
        "asset"
      ],
      "title": "AnalysisSpec",
      "type": "object"
    },
    "AnalysisWork": {
      "additionalProperties": false,
      "description": "Describe / compare / diagnose / monitor: a frozen set of `AnalysisSpec`s replayed as given.",
      "properties": {
        "type": {
          "const": "analysis",
          "default": "analysis",
          "title": "Type",
          "type": "string"
        },
        "analyses": {
          "items": {
            "$ref": "#/$defs/AnalysisSpec"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Analyses",
          "type": "array"
        },
        "statements": {
          "items": {
            "type": "string"
          },
          "title": "Statements",
          "type": "array"
        }
      },
      "required": [
        "analyses"
      ],
      "title": "AnalysisWork",
      "type": "object"
    },
    "BackfillRange": {
      "additionalProperties": false,
      "description": "The watermark range a backfill or replay covers; `start` alone bounds the initial load.",
      "properties": {
        "start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        }
      },
      "title": "BackfillRange",
      "type": "object"
    },
    "Column": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "Column",
      "type": "object"
    },
    "DatasetRef": {
      "additionalProperties": false,
      "description": "The table an ML spec learns from, read through the gateway into an immutable snapshot. `version`\npins that snapshot (its content hash): data that changed since refuses the experiment.",
      "properties": {
        "asset": {
          "pattern": "^[A-Za-z0-9_$-]+\\.[A-Za-z0-9_$-]+$",
          "title": "Asset",
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "version": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "asset"
      ],
      "title": "DatasetRef",
      "type": "object"
    },
    "Derivation": {
      "description": "A column or a safe derived expression over one column (or two for durations).\n\ntype:\n  column          -> the raw column\n  duration_hours  -> (end - start) in hours; `column` is start, `end_column` is end\n  after_hours     -> TRUE when hour(column) outside [start_hour, end_hour) or weekend\n  bucket          -> numeric column bucketed by `edges` (labels like \"0\", \"1\", \"2\", \"3+\")\n  equals          -> TRUE when column = value (boolean outcome from a categorical)\n  is_true         -> column interpreted as boolean\n  date_trunc      -> date_trunc(grain, column)\n  hour_of_day     -> extract(hour from column)\n  day_of_week     -> extract(dow from column)",
      "properties": {
        "type": {
          "default": "column",
          "enum": [
            "column",
            "duration_hours",
            "after_hours",
            "bucket",
            "equals",
            "is_true",
            "date_trunc",
            "hour_of_day",
            "day_of_week"
          ],
          "title": "Type",
          "type": "string"
        },
        "column": {
          "title": "Column",
          "type": "string"
        },
        "end_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Column"
        },
        "value": {
          "default": null,
          "title": "Value"
        },
        "edges": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Edges"
        },
        "grain": {
          "anyOf": [
            {
              "enum": [
                "day",
                "week",
                "month",
                "quarter"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grain"
        },
        "start_hour": {
          "default": 8,
          "title": "Start Hour",
          "type": "integer"
        },
        "end_hour": {
          "default": 18,
          "title": "End Hour",
          "type": "integer"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        }
      },
      "required": [
        "column"
      ],
      "title": "Derivation",
      "type": "object"
    },
    "ErrorCosts": {
      "additionalProperties": false,
      "properties": {
        "false_positive": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "False Positive",
          "type": "number"
        },
        "false_negative": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "False Negative",
          "type": "number"
        }
      },
      "title": "ErrorCosts",
      "type": "object"
    },
    "ExperimentSpec": {
      "additionalProperties": false,
      "description": "One bounded experiment over a *published* `ml_spec` definition (P5-01/P5-02): which version, an\noptional hypothesis, and budget overrides that can only tighten the definition's own.",
      "properties": {
        "type": {
          "const": "experiment",
          "default": "experiment",
          "title": "Type",
          "type": "string"
        },
        "hypothesis": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hypothesis"
        },
        "definition": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Definition"
        },
        "max_trials": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Trials"
        },
        "max_seconds": {
          "anyOf": [
            {
              "maximum": 3600,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Seconds"
        }
      },
      "title": "ExperimentSpec",
      "type": "object"
    },
    "FeatureSpec": {
      "additionalProperties": false,
      "description": "One candidate feature and when its value is known relative to the prediction cutoff.",
      "properties": {
        "column": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "type": {
          "anyOf": [
            {
              "enum": [
                "numeric",
                "categorical",
                "boolean",
                "datetime"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        },
        "available_at": {
          "default": "cutoff",
          "enum": [
            "cutoff",
            "known_in_advance",
            "after_outcome"
          ],
          "title": "Available At",
          "type": "string"
        },
        "timestamp_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp Column"
        }
      },
      "required": [
        "column"
      ],
      "title": "FeatureSpec",
      "type": "object"
    },
    "Filter": {
      "properties": {
        "column": {
          "title": "Column",
          "type": "string"
        },
        "op": {
          "enum": [
            "=",
            "!=",
            ">",
            ">=",
            "<",
            "<=",
            "in",
            "not in",
            "is null",
            "is not null"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value"
        },
        "origin": {
          "default": "plan",
          "enum": [
            "plan",
            "user_redirect",
            "policy"
          ],
          "title": "Origin",
          "type": "string"
        }
      },
      "required": [
        "column",
        "op"
      ],
      "title": "Filter",
      "type": "object"
    },
    "ImprovementConfirmation": {
      "additionalProperties": false,
      "description": "P5-07: `improved` needs more than one lucky holdout. On top of the declared minimum gain, the candidate\nmust beat the baseline (a) on the search's out-of-fold cross-validation, paired per fold: positive in a\nmajority of folds and on average, evidence from rows the holdout never saw; and (b) with the holdout gain's\ninterval at `holdout_level` excluding zero. Defaults measured to hold coin-flip targets at or below 0.5%\n`improved` (evidence/2026-09-27-ml-null-rate.md); `cross_validation: false, holdout_level: 0.95` is the\nunconfirmed pre-P5-07 rule.",
      "properties": {
        "cross_validation": {
          "default": true,
          "title": "Cross Validation",
          "type": "boolean"
        },
        "holdout_level": {
          "default": 0.99,
          "maximum": 0.999,
          "minimum": 0.95,
          "title": "Holdout Level",
          "type": "number"
        }
      },
      "title": "ImprovementConfirmation",
      "type": "object"
    },
    "Incremental": {
      "additionalProperties": false,
      "description": "Watermark incremental processing (ADR-0016, ADR-0023 decision 7, TRN-003). The same block on a\nstaged source table (source config `incremental: {table: {...}}`), on a recipe and in a PipelineSpec.\n\nA window is `[last watermark - late_window, high watermark]`, the high watermark measured once before\nreading (the fixed cursor). Rows are merged on `key` (deduplicated: the newest watermark per key\nwins) and the new watermark is committed in the same transaction as the merge. `deletes`: `reconcile`\nremoves keys the source no longer has on a scheduled full reconcile, `soft` stamps them in\n`aos_deleted_at`, `ignore` keeps them.",
      "properties": {
        "watermark": {
          "title": "Watermark",
          "type": "string"
        },
        "key": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Key",
          "type": "array"
        },
        "late_window": {
          "default": 0,
          "title": "Late Window",
          "type": "integer"
        },
        "deletes": {
          "default": "reconcile",
          "enum": [
            "reconcile",
            "soft",
            "ignore"
          ],
          "title": "Deletes",
          "type": "string"
        },
        "reconcile_every_hours": {
          "default": 168,
          "maximum": 8784,
          "minimum": 1,
          "title": "Reconcile Every Hours",
          "type": "integer"
        },
        "max_delete_pct": {
          "default": 50.0,
          "maximum": 100,
          "minimum": 0,
          "title": "Max Delete Pct",
          "type": "number"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "backfill": {
          "anyOf": [
            {
              "$ref": "#/$defs/BackfillRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "watermark",
        "key"
      ],
      "title": "Incremental",
      "type": "object"
    },
    "InputRef": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Id"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "asset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset"
        },
        "version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "title": "InputRef",
      "type": "object"
    },
    "JoinExpectation": {
      "additionalProperties": false,
      "description": "What a join may do to the data: the declared cardinality (equal to the recipe's), the share of left\nrows allowed to find no match, and the row multiplication allowed (1.0 = none).",
      "properties": {
        "node": {
          "title": "Node",
          "type": "string"
        },
        "expected_cardinality": {
          "enum": [
            "one_to_one",
            "many_to_one",
            "one_to_many",
            "many_to_many"
          ],
          "title": "Expected Cardinality",
          "type": "string"
        },
        "max_unmatched_pct": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Unmatched Pct"
        },
        "max_row_multiplication": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Row Multiplication"
        }
      },
      "required": [
        "node",
        "expected_cardinality"
      ],
      "title": "JoinExpectation",
      "type": "object"
    },
    "MLSpec": {
      "additionalProperties": false,
      "description": "P5-01 (ADR-0024, workspace spec \u00a76): what a governed model learns from and how it is judged. It pins\nthe dataset version, entity/group keys, target, feature availability, prediction cutoff, label\nhorizon, split strategy, preprocessing, allowed estimators, search budget, objective metric, slice\nguardrails, seed and (optionally) the runtime environment digest.\n\nEnvelope use stays light (a work order may name only `task`); `executable_problems` lists what a spec\nstill lacks before an experiment may start. A model may *propose* a spec; this contract and the\nreadiness checks decide.",
      "properties": {
        "type": {
          "const": "ml",
          "default": "ml",
          "title": "Type",
          "type": "string"
        },
        "task": {
          "enum": [
            "forecast",
            "classify",
            "regress",
            "cluster",
            "anomaly"
          ],
          "title": "Task",
          "type": "string"
        },
        "dataset": {
          "anyOf": [
            {
              "$ref": "#/$defs/DatasetRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "target_metric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Metric"
        },
        "positive_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Positive Class"
        },
        "target_unit": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Unit"
        },
        "entity_keys": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Entity Keys",
          "type": "array"
        },
        "group_keys": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Group Keys",
          "type": "array"
        },
        "time_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Column"
        },
        "cutoff_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cutoff Column"
        },
        "prediction_cutoff": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prediction Cutoff"
        },
        "outcome_time_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome Time Column"
        },
        "label_horizon": {
          "anyOf": [
            {
              "maximum": 3650,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label Horizon"
        },
        "horizon": {
          "anyOf": [
            {
              "maximum": 366,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Horizon"
        },
        "season_length": {
          "anyOf": [
            {
              "maximum": 366,
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Season Length"
        },
        "features": {
          "items": {
            "$ref": "#/$defs/FeatureSpec"
          },
          "maxItems": 500,
          "title": "Features",
          "type": "array"
        },
        "split": {
          "anyOf": [
            {
              "$ref": "#/$defs/SplitSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "preprocessing": {
          "$ref": "#/$defs/Preprocessing"
        },
        "estimators": {
          "items": {
            "type": "string"
          },
          "title": "Estimators",
          "type": "array"
        },
        "search": {
          "$ref": "#/$defs/SearchBudget"
        },
        "objective_metric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Objective Metric"
        },
        "min_improvement": {
          "default": 0.0,
          "minimum": 0,
          "title": "Min Improvement",
          "type": "number"
        },
        "confirmation": {
          "$ref": "#/$defs/ImprovementConfirmation"
        },
        "error_costs": {
          "$ref": "#/$defs/ErrorCosts"
        },
        "guardrails": {
          "items": {
            "$ref": "#/$defs/SliceGuardrail"
          },
          "maxItems": 10,
          "title": "Guardrails",
          "type": "array"
        },
        "k_range": {
          "default": [
            2,
            8
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "K Range",
          "type": "array"
        },
        "contamination": {
          "default": 0.02,
          "exclusiveMaximum": 0.5,
          "exclusiveMinimum": 0,
          "title": "Contamination",
          "type": "number"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "runtime_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Digest"
        }
      },
      "required": [
        "task"
      ],
      "title": "MLSpec",
      "type": "object"
    },
    "PipelineBudgets": {
      "additionalProperties": false,
      "properties": {
        "max_queries": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Queries"
        },
        "max_rows": {
          "anyOf": [
            {
              "maximum": 5000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Rows"
        },
        "max_wall_seconds": {
          "anyOf": [
            {
              "maximum": 86400,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Wall Seconds"
        }
      },
      "title": "PipelineBudgets",
      "type": "object"
    },
    "PipelineDestination": {
      "additionalProperties": false,
      "description": "Where the managed writer materializes the output: an allowlisted schema.table (P6-03).",
      "properties": {
        "engine": {
          "const": "postgres:analytics",
          "default": "postgres:analytics",
          "title": "Engine",
          "type": "string"
        },
        "schema": {
          "pattern": "^[a-z_][a-z0-9_]{0,62}$",
          "title": "Schema",
          "type": "string"
        },
        "table": {
          "pattern": "^[a-z_][a-z0-9_]{0,50}$",
          "title": "Table",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "table"
      ],
      "title": "PipelineDestination",
      "type": "object"
    },
    "PipelineFreshness": {
      "additionalProperties": false,
      "properties": {
        "max_age_hours": {
          "exclusiveMinimum": 0,
          "maximum": 8784,
          "title": "Max Age Hours",
          "type": "number"
        }
      },
      "required": [
        "max_age_hours"
      ],
      "title": "PipelineFreshness",
      "type": "object"
    },
    "PipelineInput": {
      "additionalProperties": false,
      "description": "An input version: the asset, optionally its pinned content fingerprint (a changed input refuses the\nrun) and how old its last staging may be.",
      "properties": {
        "asset": {
          "pattern": "^[a-z_][a-z0-9_]*\\.[a-z_][a-z0-9_]*$",
          "title": "Asset",
          "type": "string"
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint"
        },
        "max_age_hours": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Age Hours"
        }
      },
      "required": [
        "asset"
      ],
      "title": "PipelineInput",
      "type": "object"
    },
    "PipelineOutput": {
      "additionalProperties": false,
      "description": "The output contract: grain, keys and schema must equal the recipe output's, so a recipe change that\nalters them fails the pipeline instead of silently changing what downstream reads.",
      "properties": {
        "recipe": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recipe"
        },
        "output": {
          "title": "Output",
          "type": "string"
        },
        "grain": {
          "items": {
            "type": "string"
          },
          "title": "Grain",
          "type": "array"
        },
        "keys": {
          "items": {
            "type": "string"
          },
          "title": "Keys",
          "type": "array"
        },
        "schema": {
          "items": {
            "$ref": "#/$defs/Column"
          },
          "minItems": 1,
          "title": "Schema",
          "type": "array"
        }
      },
      "required": [
        "output",
        "schema"
      ],
      "title": "PipelineOutput",
      "type": "object"
    },
    "PipelineSpec": {
      "additionalProperties": false,
      "description": "The envelope around one or more published recipes (P6-01, workspace spec \u00a75): input versions, the\noutput grain, schema and keys, expected join cardinality, freshness, reconciliation checks, budgets,\nthe incremental block and an optional managed destination. Validated against the recipes it names\n(`pipelines/spec.py`); the recipe IR validator and compiler decide what runs.",
      "properties": {
        "type": {
          "const": "pipeline",
          "default": "pipeline",
          "title": "Type",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,55}$",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "recipes": {
          "items": {
            "$ref": "#/$defs/RecipeRef"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Recipes",
          "type": "array"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/PipelineInput"
          },
          "maxItems": 50,
          "title": "Inputs",
          "type": "array"
        },
        "output": {
          "$ref": "#/$defs/PipelineOutput"
        },
        "joins": {
          "items": {
            "$ref": "#/$defs/JoinExpectation"
          },
          "maxItems": 20,
          "title": "Joins",
          "type": "array"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/ReconciliationCheck"
          },
          "maxItems": 20,
          "title": "Checks",
          "type": "array"
        },
        "freshness": {
          "anyOf": [
            {
              "$ref": "#/$defs/PipelineFreshness"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "budgets": {
          "$ref": "#/$defs/PipelineBudgets"
        },
        "incremental": {
          "anyOf": [
            {
              "$ref": "#/$defs/Incremental"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "destination": {
          "anyOf": [
            {
              "$ref": "#/$defs/PipelineDestination"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "recipes",
        "output"
      ],
      "title": "PipelineSpec",
      "type": "object"
    },
    "Preprocessing": {
      "additionalProperties": false,
      "description": "Fitted on training folds only and carried unchanged into validation, holdout and scoring.",
      "properties": {
        "numeric_impute": {
          "default": "median",
          "enum": [
            "median",
            "mean",
            "zero"
          ],
          "title": "Numeric Impute",
          "type": "string"
        },
        "scale": {
          "default": true,
          "title": "Scale",
          "type": "boolean"
        },
        "categorical_impute": {
          "default": "constant",
          "enum": [
            "most_frequent",
            "constant"
          ],
          "title": "Categorical Impute",
          "type": "string"
        },
        "max_categories": {
          "default": 30,
          "maximum": 500,
          "minimum": 2,
          "title": "Max Categories",
          "type": "integer"
        }
      },
      "title": "Preprocessing",
      "type": "object"
    },
    "RecipeRef": {
      "additionalProperties": false,
      "description": "A recipe step of a pipeline: its name, and a version to pin (None = the published version at run time).",
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,55}$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "name"
      ],
      "title": "RecipeRef",
      "type": "object"
    },
    "ReconciliationCheck": {
      "additionalProperties": false,
      "description": "Aggregate reconciliation: `func(input_column)` over a recipe node against `func(output_column)` over\nthe output, within `tolerance_pct` (a business measure must not multiply after a join).",
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,55}$",
          "title": "Name",
          "type": "string"
        },
        "func": {
          "default": "sum",
          "enum": [
            "sum",
            "count"
          ],
          "title": "Func",
          "type": "string"
        },
        "input_node": {
          "title": "Input Node",
          "type": "string"
        },
        "input_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Column"
        },
        "output_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Column"
        },
        "tolerance_pct": {
          "default": 0.0,
          "maximum": 100,
          "minimum": 0,
          "title": "Tolerance Pct",
          "type": "number"
        }
      },
      "required": [
        "name",
        "input_node"
      ],
      "title": "ReconciliationCheck",
      "type": "object"
    },
    "SearchBudget": {
      "additionalProperties": false,
      "description": "Requested caps; the platform clamps each to its hard ceiling (settings ml_max_*).",
      "properties": {
        "max_trials": {
          "default": 12,
          "maximum": 200,
          "minimum": 1,
          "title": "Max Trials",
          "type": "integer"
        },
        "max_seconds": {
          "default": 300,
          "maximum": 3600,
          "minimum": 1,
          "title": "Max Seconds",
          "type": "integer"
        },
        "max_rows": {
          "default": 100000,
          "maximum": 5000000,
          "minimum": 50,
          "title": "Max Rows",
          "type": "integer"
        }
      },
      "title": "SearchBudget",
      "type": "object"
    },
    "SliceGuardrail": {
      "additionalProperties": false,
      "description": "Within every slice of `column` with at least `min_rows` holdout rows, the candidate may be worse than\nthe baseline by at most `max_degradation` (objective metric units); otherwise it is not promotable.",
