# compose profile `isolated` (ADR-0022, P7-06): the credential-free compute-py / compute-ml worker pools on the
# internal `isolated` network, reached over Temporal. On top of standard:
# docker compose --env-file .env --env-file deploy/compose/standard.env --env-file deploy/compose/isolated.env up -d --build
COMPOSE_PROFILES=standard,isolated
ANALYSTOS_ISOLATED_POOLS=compute-py,compute-ml
ANALYSTOS_ISOLATED_TRANSPORT=temporal
ANALYSTOS_WORKER_ARTIFACT_URL=http://api:8000
