# compose profile `scale`: standard with one worker pool per task queue (today's Helm defaults).
# docker compose --env-file .env --env-file deploy/compose/scale.env up -d --build
COMPOSE_PROFILES=scale
ANALYSTOS_PROFILE=scale
ANALYSTOS_ORCHESTRATOR=temporal
ANALYSTOS_REDIS_URL=redis://redis:6379/0
ANALYSTOS_API_EXTRAS=reports,temporal
