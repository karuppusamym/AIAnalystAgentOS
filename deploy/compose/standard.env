# compose profile `standard` (ADR-0025): Redis, Temporal, one worker on every queue, a scheduler process.
# docker compose --env-file .env --env-file deploy/compose/standard.env up -d --build
COMPOSE_PROFILES=standard
ANALYSTOS_PROFILE=standard
ANALYSTOS_ORCHESTRATOR=temporal
ANALYSTOS_REDIS_URL=redis://redis:6379/0
ANALYSTOS_API_EXTRAS=reports,temporal
