# Local development settings. Copy to `.env` (git-ignored):  copy dev.env .env
# No secrets here; put your own keys in `.env` only.
#
# LITE profile (the default): Postgres + API + web. Runs execute in the API process, the scheduler runs in the API,
# spend caps live in Postgres. No Redis, Temporal, worker or Superset needed. Start with:  docker compose up -d postgres
# STANDARD profile (Redis, Temporal, worker, scheduler): set ANALYSTOS_PROFILE=standard and ANALYSTOS_ORCHESTRATOR=temporal,
# start `docker compose --profile standard up -d`, and install the extra: pip install -e ".[standard]"
# Leaving ANALYSTOS_REDIS_URL / ANALYSTOS_SUPERSET_URL unset keeps them off in lite; setting them makes the app expect them.

ANALYSTOS_ENV=dev
ANALYSTOS_PROFILE=lite
ANALYSTOS_ORCHESTRATOR=local

ANALYSTOS_DATABASE_URL=postgresql+psycopg://analystos:analystos@localhost:5432/analystos
ANALYSTOS_ANALYTICS_LOADER_URL=postgresql+psycopg://analystos_loader:loader@localhost:5432/analytics
ANALYSTOS_ANALYTICS_READER_URL=postgresql+psycopg://analystos_reader:reader@localhost:5432/analytics
ANALYSTOS_ANALYTICS_BUILDER_URL=postgresql+psycopg://analystos_builder:builder@localhost:5432/analytics
ANALYSTOS_ANALYTICS_WRITER_URL=postgresql+psycopg://analystos_writer:writer@localhost:5432/analytics

ANALYSTOS_JWT_SECRET=dev-only-change-me-please-32bytes!!
ANALYSTOS_BOOTSTRAP_ADMIN_EMAIL=admin@analystos.local
ANALYSTOS_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

ANALYSTOS_WEB_URL=http://localhost:5173
ANALYSTOS_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ANALYSTOS_SERVICENOW_MOCK_URL=http://localhost:8090

# Only for the STANDARD profile / BI (uncomment together with the profile above):
# ANALYSTOS_REDIS_URL=redis://localhost:6379/0
# ANALYSTOS_TEMPORAL_ADDRESS=localhost:7233
# ANALYSTOS_SUPERSET_URL=http://localhost:8088   (docker compose --profile bi up -d)

# Neo4j is optional (docker compose --profile graph).
ANALYSTOS_GRAPH_ENABLED=false

# Model access. Empty = rules-only. Paste your own OpenRouter key in `.env` (read unprefixed on purpose).
OPENROUTER_API_KEY=

# Source passwords are referenced from sources as secret_ref: env:NAME, e.g. SERVICENOW_PASSWORD=
