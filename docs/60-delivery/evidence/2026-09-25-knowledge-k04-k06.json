            "property": "querySql",
            "value": "SELECT t.\"sys_id\", t.\"number\", t.\"opened_at\", t.\"resolved_at\", t.\"closed_at\", t.\"priority\", t.\"impact\", t.\"urgency\", t.\"state\", t.\"category\", t.\"assignment_group\", t.\"assignment_group_name\", t.\"cmdb_ci\", t.\"cmdb_ci_name\", t.\"caused_by\", t.\"caused_by_name\", t.\"reassignment_count\", t.\"reopen_count\", t.\"made_sla\", t.\"contact_type\", t.\"short_description\", t.\"caller_id\", t.\"sys_updated_on\", CAST((EXTRACT(EPOCH FROM CAST(\"t\".\"resolved_at\" AS TIMESTAMP)) - EXTRACT(EPOCH FROM CAST(\"t\".\"opened_at\" AS TIMESTAMP))) AS DOUBLE PRECISION) / 3600.0 AS \"opened_at_to_resolved_at_hours\", CASE WHEN \"t\".\"opened_at\" IS NULL THEN NULL WHEN EXTRACT(HOUR FROM CAST(\"t\".\"opened_at\" AS TIMESTAMP)) < 8 OR EXTRACT(HOUR FROM CAST(\"t\".\"opened_at\" AS TIMESTAMP)) >= 18 OR EXTRACT(DOW FROM CAST(\"t\".\"opened_at\" AS TIMESTAMP)) IN (0, 6) THEN 1 ELSE 0 END AS \"opened_at_after_hours\", CASE WHEN \"t\".\"made_sla\" IS NULL THEN NULL WHEN CASE WHEN \"t\".\"made_sla\" IS NULL THEN NULL WHEN LOWER(TRIM(CAST(\"t\".\"made_sla\" AS VARCHAR))) IN ('true', 't', '1', 'yes', 'y') THEN 1 ELSE 0 END = 0 THEN 1 ELSE 0 END AS \"made_sla_is_false\", CASE WHEN \"t\".\"reassignment_count\" IS NULL THEN NULL WHEN \"t\".\"reassignment_count\" < 0.0 THEN '(<0)' WHEN \"t\".\"reassignment_count\" < 1.0 THEN '0' WHEN \"t\".\"reassignment_count\" < 2.0 THEN '1' WHEN \"t\".\"reassignment_count\" < 3.0 THEN '2' ELSE '3+' END AS \"reassignment_count_bucket\", DATE_TRUNC('MONTH', CAST(\"t\".\"opened_at\" AS TIMESTAMP)) AS \"opened_at_month\", EXTRACT(DOW FROM CAST(\"t\".\"opened_at\" AS TIMESTAMP)) AS \"opened_at_dow\", EXTRACT(HOUR FROM CAST(\"t\".\"opened_at\" AS TIMESTAMP)) AS \"opened_at_hour\" FROM src_src_cf36f2899d27.incident AS t",
            "vendor": "analystos"
          },
